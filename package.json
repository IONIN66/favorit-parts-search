    "react-redux": "^8.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "steiger": "^0.7.0",
    "vite": "^4.5.14",
    "zod-validation-error": "^4.0.2"
